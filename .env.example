# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Configuration
# Local SQLite persistence (default) or PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///./data/billing.db

# Stripe Configuration (Test Mode Only)
# Never commit real or live keys!
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here
STRIPE_PRO_PRICE_ID=price_test_pro_monthly

# Quota & Rate Limit Defaults
DEFAULT_RETRY_AFTER_SECONDS=60
